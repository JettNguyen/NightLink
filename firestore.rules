rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function userIsInAuthorFollowing(authorUserId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(authorUserId)).data.followingIds;
    }

    function userIsInAuthorFollowers(authorUserId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(authorUserId)).data.followerIds;
    }

    function canReadDream(dreamData) {
      return isOwner(dreamData.userId) ||
        (dreamData.visibility == 'public') ||
        (dreamData.visibility == 'anonymous') ||
        (dreamData.visibility == 'following' && userIsInAuthorFollowing(dreamData.userId)) ||
        (dreamData.visibility == 'followers' && userIsInAuthorFollowers(dreamData.userId));
    }

    function isNoOpFollowerChange() {
      return request.resource.data.followerIds.size() == resource.data.followerIds.size() &&
        request.resource.data.followerIds.hasAll(resource.data.followerIds) &&
        resource.data.followerIds.hasAll(request.resource.data.followerIds);
    }

    function isAddSelfFollowerChange() {
      return !(request.auth.uid in resource.data.followerIds) &&
        (request.auth.uid in request.resource.data.followerIds) &&
        request.resource.data.followerIds.size() == resource.data.followerIds.size() + 1 &&
        request.resource.data.followerIds.hasAll(resource.data.followerIds);
    }

    function isRemoveSelfFollowerChange() {
      return (request.auth.uid in resource.data.followerIds) &&
        !(request.auth.uid in request.resource.data.followerIds) &&
        request.resource.data.followerIds.size() == resource.data.followerIds.size() - 1 &&
        resource.data.followerIds.hasAll(request.resource.data.followerIds);
    }

    function canMutateFollowerIdsBySelf() {
      return isAuthenticated() &&
        request.method == 'update' &&
        resource.data.followerIds is list &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerIds']) &&
        request.resource.data.followerIds is list &&
        (isNoOpFollowerChange() || isAddSelfFollowerChange() || isRemoveSelfFollowerChange());
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || canMutateFollowerIdsBySelf();
    }

    // Username index used for signup/signin lookup
    match /usernames/{normalizedUsername} {
      allow read: if true;

      // Pre-auth reservation step during email signup
      allow create: if request.auth == null &&
        request.resource.data.keys().hasOnly(['normalizedUsername', 'reservedAt']) &&
        request.resource.data.normalizedUsername == normalizedUsername &&
        normalizedUsername.matches('^[a-z0-9_]{3,20}$');

      // Claim/update username to a specific authenticated uid
      allow update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['normalizedUsername', 'reservedAt', 'uid', 'username', 'email', 'updatedAt']) &&
        request.resource.data.normalizedUsername == normalizedUsername &&
        request.resource.data.uid == request.auth.uid &&
        (resource.data.uid == null || resource.data.uid == request.auth.uid);

      // Allow cleanup of unclaimed reservations and owner-managed deletes
      allow delete: if resource.data.uid == null || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Dreams: visibility-based access control
    match /dreams/{dreamId} {
      allow read: if canReadDream(resource.data);
      allow write: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId);

      // Comments under dreams - can read if dream is readable
      match /comments/{commentId} {
        allow read: if canReadDream(get(/databases/$(database)/documents/dreams/$(dreamId)).data);
        allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
        allow write, delete: if isOwner(resource.data.userId);
      }
    }

    // Activity under users - private to user
    match /users/{userId}/activity/{activityId} {
      allow read, write: if isOwner(userId);
    }
  }
}