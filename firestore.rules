rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read other users' profiles (for display names, etc.)
    match /users/{userId} {
      allow read: if request.auth != null;
    }

    // Dreams: owners can write, anyone can read
    match /dreams/{dreamId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Comments under dreams
    match /dreams/{dreamId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Activity under users
    match /users/{userId}/activity/{activityId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}