rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function userIsInAuthorFollowing(authorUserId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(authorUserId)).data.followingIds;
    }

    function userIsInAuthorFollowers(authorUserId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(authorUserId)).data.followerIds;
    }

    function canReadDream(dreamData) {
      return isOwner(dreamData.userId) ||
        (dreamData.visibility == 'public') ||
        (dreamData.visibility == 'anonymous') ||
        (dreamData.visibility == 'following' && userIsInAuthorFollowing(dreamData.userId)) ||
        (dreamData.visibility == 'followers' && userIsInAuthorFollowers(dreamData.userId));
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Users can read other users' public profiles (for display names, etc.)
    match /users/{userId} {
      allow read: if isAuthenticated();
    }

    // Dreams: visibility-based access control
    match /dreams/{dreamId} {
      allow read: if canReadDream(resource.data);
      allow write: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId);

      // Comments under dreams - can read if dream is readable
      match /comments/{commentId} {
        allow read: if canReadDream(get(/databases/$(database)/documents/dreams/$(dreamId)).data);
        allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
        allow write, delete: if isOwner(resource.data.userId);
      }
    }

    // Activity under users - private to user
    match /users/{userId}/activity/{activityId} {
      allow read, write: if isOwner(userId);
    }
  }
}